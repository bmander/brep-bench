// The rectangle drawn in the xz plane, turned a quarter about the z axis, from +x towards +y.
Model RevolvedSector {
  units: mm
  Axis z { origin: [0mm, 0mm, 0mm]; direction: [0, 0, 1] }
  Concept Struct layout on XZ {
    Rect2 section { center: [8mm, 2mm]; size: [4mm, 4mm] }
  }
  Profile meridian using layout { Loop Outer { section |> TraceLoop } }
  Revolve sector { profile: meridian; about: z; angle: 90deg }
}
