// The first block as the stock; the second block's footprint cut through it.
Model BoxesCut {
  units: mm
  Profile first = Rect2 { center: [5mm, 5mm]; size: [10mm, 10mm] }
  Profile second = Rect2 { center: [10mm, 10mm]; size: [10mm, 10mm] }
  Compose body {
    Base stock { profile: first; from: 0mm; to: 10mm; role: Stock }
    Remove cut { profile: second; from: 0mm; to: 10mm; role: ThroughCut }
  }
}
