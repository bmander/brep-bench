// The cube as the stock, the cylinder's disc added over the same heights.
Model HalfCylinderBossTangent {
  units: mm
  Profile square = Rect2 { center: [5mm, 5mm]; size: [10mm, 10mm] }
  Profile disc = Circle2 { center: [10mm, 5mm]; radius: 5mm }
  Compose body {
    Base stock { profile: square; from: 0mm; to: 10mm; role: Stock }
    Add boss { profile: disc; from: 0mm; to: 10mm }
  }
}
