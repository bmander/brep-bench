// The first cube as the stock, the second raised on its top as a Boss that overhangs it by half.
Model BoxesSharingPartOfAFace {
  units: mm
  Profile first = Rect2 { center: [5mm, 5mm]; size: [10mm, 10mm] }
  Profile second = Rect2 { center: [10mm, 5mm]; size: [10mm, 10mm] }
  Compose body {
    Base stock { profile: first; from: 0mm; to: 10mm; role: Stock }
    Boss upper { on: Top; profile: second; height: 10mm }
  }
}
