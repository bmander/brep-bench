{
  "kernels": [
    {
      "name": "cad-kernel",
      "kernel": "https://crates.io/crates/cad-kernel",
      "license": "MIT OR Apache-2.0",
      "backend": "Rust",
      "frontend": "Rust",
      "build": [
        "cargo",
        "build",
        "--release",
        "--manifest-path",
        "kernels/cad-kernel/Cargo.toml"
      ],
      "command": [
        "kernels/cad-kernel/target/release/brep-bench-cad-kernel"
      ],
      "version": [
        "kernels/cad-kernel/target/release/brep-bench-cad-kernel",
        "--version"
      ],
      "source": "kernels/cad-kernel/src/cases/{category}/{name_snake}.rs",
      "step": true,
      "binary": ["kernels/cad-kernel/target/release/brep-bench-cad-kernel"]
    },
    {
      "name": "occt",
      "reference": true,
      "kernel": "https://github.com/Open-Cascade-SAS/OCCT",
      "license": "LGPL-2.1 with exception",
      "backend": "C++",
      "frontend": "Python (the OCP bindings)",
      "build": [
        "python3",
        "-m",
        "pip",
        "install",
        "cadquery-ocp"
      ],
      "command": [
        "python3",
        "kernels/occt/run.py"
      ],
      "version": [
        "python3",
        "kernels/occt/run.py",
        "--version"
      ],
      "source": "kernels/occt/cases/{category}/{name_snake}.py",
      "step": true,
      "binary": [{"python": "python3", "distribution": "cadquery-ocp"}]
    },
    {"name": "monstertruck", "kernel": "https://github.com/virtualritz/monstertruck", "license": "Apache-2.0", "backend": "Rust", "frontend": "Rust", "command": null},
    {
