      "source": "kernels/smlib-cpp/src/cases/{category}/{name_snake}.cpp",
      "step": "SM_API writes USD and SMLib's own format, and has no STEP writer",
      "binary": ["kernels/smlib-cpp/build/brep-bench-smlib-cpp", "kernels/smlib-cpp/upstream/lib"]
