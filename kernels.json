        "--version"
      ],
      "source": "kernels/arris/src/cases/{category}/{name_snake}.rs",
      "step": true,
      "binary": ["kernels/arris/target/release/brep-bench-arris"]
    },
    {
      "name": "kentron",
      "kernel": "https://github.com/rsz269/kentron",
      "license": "MIT OR Apache-2.0",
      "backend": "Rust",
